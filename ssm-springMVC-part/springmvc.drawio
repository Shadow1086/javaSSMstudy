        <mxCell id="view" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;" value="&lt;div&gt;&lt;b&gt;视图页面&lt;/b&gt;&lt;/div&gt;&lt;div&gt;index.html&lt;/div&gt;&lt;div&gt;login.html&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="90" y="840" as="geometry" />
        </mxCell>
        <mxCell id="steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#c0c0c0;fontSize=14;align=left;spacingLeft=12;spacingTop=8;" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;步骤说明&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;1. 用户发送请求给 DispatcherServlet&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;2. DispatcherServlet 调用 HandlerMapping&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;3. HandlerMapping 找到方法并返回给 DispatcherServlet&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;4. DispatcherServlet 调用 HandlerAdapter&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;5. HandlerAdapter 调用 Controller 方法&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;6. Controller 调用 Service&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;7. Service 调用 Dao&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;8. Controller 执行完成后返回 ModelAndView / 数据&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;9. HandlerAdapter 把结果返回给 DispatcherServlet&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;10. DispatcherServlet 调用 ViewResolver 解析视图名&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;11. ViewResolver 定位具体页面&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;12. DispatcherServlet 渲染完成后响应给用户&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="660" width="340" x="1440" y="120" as="geometry" />
        </mxCell>
