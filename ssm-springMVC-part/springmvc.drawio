        </mxCell>
        <mxCell id="dispatcher" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" value="&lt;div&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;DispatcherServlet&lt;/b&gt;&lt;/div&gt;&lt;div&gt;统一请求入口&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="360" y="220" as="geometry" />
        </mxCell>
        <mxCell id="mapping" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;" value="&lt;div&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;HandlerMapping&lt;/b&gt;&lt;/div&gt;&lt;div&gt;查找 handler 方法&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="250" x="700" y="220" as="geometry" />
        </mxCell>
        <mxCell id="adapter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" value="&lt;div&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;HandlerAdapter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;参数绑定 + 调用方法&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="360" y="450" as="geometry" />
        </mxCell>
        <mxCell id="controller" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="&lt;div&gt;&lt;b&gt;UserController&lt;/b&gt;&lt;/div&gt;&lt;div&gt;login() / register()&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="210" x="700" y="450" as="geometry" />
        </mxCell>
        <mxCell id="service" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="&lt;div&gt;&lt;b&gt;UserService&lt;/b&gt;&lt;/div&gt;&lt;div&gt;业务处理&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="180" x="1000" y="450" as="geometry" />
        </mxCell>
        <mxCell id="dao" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="&lt;div&gt;&lt;b&gt;UserDao&lt;/b&gt;&lt;/div&gt;&lt;div&gt;数据访问&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="170" x="1260" y="450" as="geometry" />
