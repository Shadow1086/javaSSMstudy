        <mxCell id="resolver" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" value="&lt;div&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;ViewResolver&lt;/b&gt;&lt;/div&gt;&lt;div&gt;解析视图名&lt;/div&gt;&lt;div&gt;/web-info/html/ + .html&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="90" y="660" as="geometry" />
