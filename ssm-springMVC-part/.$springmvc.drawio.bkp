        <mxCell id="steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#c0c0c0;fontSize=14;align=left;spacingLeft=12;spacingTop=8;" value="&lt;div&gt;&lt;b&gt;步骤说明&lt;/b&gt;&lt;/div&gt;&lt;hr /&gt;&lt;div&gt;1. 用户发送请求给 DispatcherServlet&lt;/div&gt;&lt;div&gt;2. DispatcherServlet 调用 HandlerMapping&lt;/div&gt;&lt;div&gt;3. HandlerMapping 找到方法并返回给 DispatcherServlet&lt;/div&gt;&lt;div&gt;4. DispatcherServlet 调用 HandlerAdapter&lt;/div&gt;&lt;div&gt;5. HandlerAdapter 调用 Controller 方法&lt;/div&gt;&lt;div&gt;6. Controller 调用 Service&lt;/div&gt;&lt;div&gt;7. Service 调用 Dao&lt;/div&gt;&lt;div&gt;8. Controller 执行完成后返回 ModelAndView / 数据&lt;/div&gt;&lt;div&gt;9. HandlerAdapter 把结果返回给 DispatcherServlet&lt;/div&gt;&lt;div&gt;10. DispatcherServlet 调用 ViewResolver 解析视图名&lt;/div&gt;&lt;div&gt;11. ViewResolver 定位具体页面&lt;/div&gt;&lt;div&gt;12. DispatcherServlet 渲染完成后响应给用户&lt;/div&gt;" vertex="1">
          <mxGeometry x="1490" y="170" width="270" height="470" as="geometry" />
        </mxCell>

